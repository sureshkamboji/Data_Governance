        w in str(s5.get("responsible_role","")).lower()
        for w in role_keywords
    )
    threshold_ok = any(
        w in str(s5.get("review_trigger_threshold","")).lower()
        for w in threshold_keywords
    )
    bias_specific = (
        len(str(s2.get("bias_indicators_found","")).strip()) >= 40 and
        len(str(s2.get("bias_mitigation","")).strip()) >= 40
    )

    checks = {
        "Section 2: Training data sources described":
            filled(s2.get("data_sources","")),
        "Section 2: Bias indicators and mitigation are specific":
            bias_specific,
        "Section 3: Cites a specific GDPR Article 6 legal basis":
            gdpr_ok,
        "Section 3: Special category data position stated":
            filled(s3.get("special_category_data",""), 10),
        "Section 4: Addresses GDPR Art.22 or right to explanation":
            art22_ok,
        "Section 4: Customer-facing explanation is plain English":
            filled(s4.get("customer_facing_explanation",""), 30),
        "Section 5: Specific threshold triggers model review":
            threshold_ok,
        "Section 5: Named role is accountable for annual review":
            role_ok,
    }

    print("YOUR GOVERNANCE CARD SUMMARY:\n")
    for section in ["section_2","section_3","section_4","section_5"]:
        n = section.split("_")[1]
        names = {"2":"Training Data","3":"Privacy","4":"Explainability","5":"Monitoring"}
        d = my_governance_card[section]
        first_val = str(list(d.values())[0])[:55]
        print(f"  Section {n} ({names[n]}): {first_val}...")
    print()

    print("GOVERNANCE CHECK:\n")
    passed = 0
    for item, ok in checks.items():
        icon = "  [Y]" if ok else "  [ ]"
        print(f"  {icon} {item}")
        if ok: passed += 1
    print()
    print(f"SCORE: {passed} out of {len(checks)}")
    print()

    if not gdpr_ok:
        print("  Section 3: Add a specific GDPR Article 6 citation.")
        print("  'We comply with GDPR' is not enough for a regulator.")
        print("  Name the basis: 'GDPR Article 6(1)(a) - consent'")
        print("  or 'Article 6(1)(f) - legitimate interests'.")
        print()
    if not art22_ok:
        print("  Section 4: Address GDPR Article 22 explicitly.")
        print("  Article 22 gives customers the right to meaningful")
        print("  information about automated decisions and the right")
        print("  to request human review. Your explainability section")
