def w(text, width=60, pad="     "):
    if not str(text).strip():
        return pad + "(not provided)"
    words = str(text).split()
    lines, line = [], pad
    for word in words:
        if len(line) + len(word) + 1 > width:
            lines.append(line)
            line = pad
        line += word + " "
    if line.strip():
        lines.append(line)
    return "\n".join(lines)

