    if not s3_done: missing.append("Section 3 (privacy and consent)")
    if not s4_done: missing.append("Section 4 (explainability)")
    if not s5_done: missing.append("Section 5 (monitoring and review)")
    print(f"  {sections_complete} of 4 sections complete.")
