gdpr_art6_keywords = [
    "article 6","art. 6","art 6","6(1)(a)","6(1)(b)","6(1)(c)",
    "6(1)(d)","6(1)(e)","6(1)(f)","consent","legitimate interest",
    "legal obligation","contract","vital interest","public task",
]

art22_keywords = [
    "article 22","art. 22","art 22","right to explanation",
    "right to human","automated decision","solely automated",
    "human review","human oversight","escalat","challenge",
    "meaningful information",
]

role_keywords = [
    "officer","cdo","chief data","team","committee","steward",
    "manager","owner","lead","governance","compliance","scientist",
    "board","director","function","head of",
]

threshold_keywords = [
    "%","percent","percentage","rate","gap","basis point",
    "drop","falls below","exceeds","above","below","days",
    "complaints","trigger","threshold","point",
]

def filled(val, min_len=25):
    return bool(str(val).strip()) and len(str(val).strip()) >= min_len

s1 = my_governance_card["section_1"]
s2 = my_governance_card["section_2"]
s3 = my_governance_card["section_3"]
s4 = my_governance_card["section_4"]
s5 = my_governance_card["section_5"]

s2_done = all(filled(s2.get(k,"")) for k in
              ["data_sources","representativeness_checks",
               "bias_indicators_found","bias_mitigation"])
s3_done = all(filled(s3.get(k,"")) for k in
              ["personal_data_processed","gdpr_legal_basis",
               "special_category_data","data_minimisation_measures"])
s4_done = all(filled(s4.get(k,"")) for k in
              ["explanation_method","customer_facing_explanation",
               "human_review_process"])
s5_done = all(filled(s5.get(k,"")) for k in
              ["drift_detection","review_trigger_threshold",
               "responsible_role","review_frequency"])

sections_complete = sum([s2_done, s3_done, s4_done, s5_done])

